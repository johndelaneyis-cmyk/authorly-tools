# Copy this file to .env and fill in your tokens.
# .env is gitignored — do NOT commit it.

# Reddit (https://www.reddit.com/prefs/apps -> create app -> script type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# X / Twitter (https://developer.x.com -> Free tier; create app with Read+Write)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Discord webhooks (one per indie-author server you want to post to)
# DISCORD_WEBHOOK_20BOOKS=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_KDPAUTHORS=https://discord.com/api/webhooks/...

# Site URL (purely informational)
SITE_URL=https://authorly.tools
