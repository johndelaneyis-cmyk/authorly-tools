/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types default 'allow-duplicates'
  X-Permitted-Cross-Domain-Policies: none
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# HTML pages: short cache so updates ship fast, but stale-while-revalidate
# lets repeat visitors render instantly while CF re-fetches in the background.
/
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
/*.html
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# Static assets that change rarely — cache aggressively at the edge.
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/manifest.webmanifest
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Shared client runtime: cache 1h at edge, allow 1d stale serve while CF re-fetches.
# Long-cache + content-hash filenames would be ideal but we don't have a build step;
# 1h max-age + 1d SWR keeps updates ship-fast without re-fetching every visitor.
/tool.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/tool.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/feedback.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/page/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Long-form guides: same cadence as HTML pages so edits ship fast.
/guides
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
/guides/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600

# API responses are already no-store from each function — no rule needed here.